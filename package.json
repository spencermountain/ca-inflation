{
  "name": "ca-inflation",
  "version": "0.0.2",
  "description": "calculate the inflation rate of the Canadian dollar",
  "main": "src/index.js",
  "unpkg": "builds/ca-inflation.min.js",
  "types": "types/index.d.ts",
  "type": "module",
  "homepage": "https://work.spencermountain.dev/ca-inflation",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./builds/ca-inflation.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./builds/ca-inflation.cjs"
      }
    }
  },
  "scripts": {
    "build": "rollup -c --silent",
    "update": "node ./scripts/update.js",
    "release": "./scripts/release.sh",
    "test": "tape tests/*.test.js | tap-dancer",
    "watch": "node --watch scratch.js",
    "lint": "eslint ."
  },
  "repository": "github:spencermountain/ca-inflation",
  "files": [
    "src",
    "builds",
    "types"
  ],
  "prettier": {
    "trailingComma": "none",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "eslint": "10.11.0",
    "rollup": "4.63.4",
    "rollup-plugin-commonjs": "10.1.0",
    "rollup-plugin-node-resolve": "5.2.0",
    "tap-dancer": "0.4.0",
    "tape": "5.10.2"
  },
  "license": "MIT"
}
